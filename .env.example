# Copy to .env and fill
GEMINI_API_KEY=
# Optional alias
# GOOGLE_API_KEY=
DJANGO_SECRET_KEY=dev-only-change-this-secret-key
DJANGO_DEBUG=1
# Supabase Pooler (Transaction 6543)
DATABASE_URL=postgresql://postgres.<REF>:<PASS>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or individual DB vars:
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=
